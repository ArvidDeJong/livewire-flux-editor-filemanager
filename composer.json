{
    "name": "darvis/livewire-flux-editor-filemanager",
    "description": "Laravel Filemanager integration for the Flux Pro editor: insert images and file links from Laravel Filemanager, resize and align images, drag and drop or paste images.",
    "keywords": [
        "laravel",
        "livewire",
        "flux",
        "flux-ui",
        "tiptap",
        "editor",
        "wysiwyg",
        "filemanager",
        "laravel-filemanager",
        "images",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/livewire-flux-editor-filemanager/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/livewire-flux-editor-filemanager/issues",
        "source": "https://github.com/ArvidDeJong/livewire-flux-editor-filemanager"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    ],
    "autoload": {
        "psr-4": {
            "Darvis\\FluxFilemanager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\FluxFilemanager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\FluxFilemanager\\FluxFilemanagerServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "livewire/flux": "^2.0.2",
        "livewire/flux-pro": "^2.0.2",
        "unisharp/laravel-filemanager": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
